.kc
  = render "shared/header"

  main.kc-home
    section.kc-hero
      / Title written into manuscript-paper squares, small ャ sits in its own square like in 原稿用紙
      h1.kc-genko aria-label="Kana Champion"
        - %w[か な チ ャ ン ピ オ ン].each_with_index do |char, i|
          span.kc-genko__cell class=("is-small" if char == "ャ") style="--i: #{i}" aria-hidden="true" = char
      p.kc-lead Тренажёр хираганы и катаканы на скорость. Видишь символ — пишешь его чтение латиницей.
      = link_to "Начать игру", game_index_path, class: "kc-button"

      dl.kc-facts
        div
          dt Игр сыграно
          dd = @games_count
        div
          dt Рекорд
          dd = @best_score || "пока нет"

    section.kc-section
      h2.kc-section__title Как играть
      ol.kc-steps
        li Выбери хирагану, катакану или обе азбуки.
        li Вводи ромадзи для каждого символа и жми Enter.
        li Чем точнее и быстрее, тем больше баллов. Соревнуйся с друзьями за первое место.

    section.kc-section
      h2.kc-section__title Рекорды
      .kc-boards
        - @leaderboards.each_key.with_index do |mode, i|
          input.kc-boards__radio type="radio" name="leaderboard" id="board-#{mode}" checked=i.zero?
        .kc-tabs
          - @leaderboards.each do |mode, board|
            label.kc-tab for="board-#{mode}"
              span.kc-tab__glyph = board[:glyph]
              span.kc-tab__name = board[:title]

        - @leaderboards.each do |mode, board|
          .kc-boards__panel class="kc-boards__panel--#{mode}"
            - if board[:games].any?
              ol.kc-leaderboard
                - board[:games].each_with_index do |game, i|
                  li.kc-leaderboard__row class=("is-top" if i.zero?)
                    span.kc-leaderboard__rank = i + 1
                    span.kc-leaderboard__name
                      span = game.name
                    span.kc-leaderboard__score = game.points
                    span.kc-leaderboard__meta
                      | #{game.kana_right} из #{game.kana_count} за #{game.time} с
                    span.kc-leaderboard__date = game.created_at.strftime("%d.%m.%Y")
            - else
              .kc-empty
                p В этой таблице пока пусто. Первая сыгранная партия займёт первое место.
                = link_to "Сыграть", game_index_path, class: "kc-link"
